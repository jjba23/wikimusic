                              (if (json-null? value)
                                  #f
                                  value))
                            #:artists
                            (let ((value (jso-ref node "artists")))
                              (if (json-null? value)
                                  #f
                                  value))
                            #:genres
                            (let ((value (jso-ref node "genres")))
                              (if (json-null? value)
                                  #f
                                  value)))))

(define* (instance-counts-apply-patch value patch)
  "Return VALUE with the RFC 7386 JSON merge patch PATCH applied.
Members of PATCH set to null are removed, and the result is validated
like any other InstanceCounts, so a patch that would leave the record invalid raises."
  (jso->instance-counts (json-merge-patch (instance-counts->jso value) patch)))

(define* (make-instance #:key (name #f) (version #f) (counts #f))
  "Create a Instance.

The instance a client is talking to.

Fields: name (string, required), version (string, required), counts (InstanceCounts, required).

@example
(make-instance #:name <string> #:version <string> #:counts <InstanceCounts>)
@end example"
  (let ((value (%make-instance name version counts)))
    (validate-instance value)
    value))

(define (validate-instance value)
  "Check VALUE against the constraints the specification declares for Instance.

Returns #t, or throws 'openapi-validation-error naming the field at fault."
  (check-predicate '("instance") value instance? "Instance")
  (check-required '("instance" "name") (instance-name value))
  (check-type '("instance" "name") (instance-name value) 'string)
  (check-required '("instance" "version") (instance-version value))
  (check-type '("instance" "version") (instance-version value) 'string)
  (check-required '("instance" "counts") (instance-counts value))
  (check-predicate '("instance" "counts") (instance-counts value)
                   instance-counts? "InstanceCounts")
  #t)

(define (instance-valid? value)
  "Return #t when VALUE is a valid Instance."
  (valid? (lambda () (validate-instance value))))

(define (instance->jso value)
  "Return VALUE as a jso object, ready for JSON serialisation."
  (check-predicate '("instance") value instance? "Instance")
  (append (list (cons "name" (instance-name value)))
          (list (cons "version" (instance-version value)))
          (list (cons "counts" (instance-counts->jso (instance-counts value))))))

(define (jso->instance node)
  "Build a Instance from NODE, a jso object."
  (if (or (json-null? node) (not (jso-object? node)))
      #f
      (make-instance
                     #:name
                     (let ((value (jso-ref node "name")))
                       (if (json-null? value)
                           #f
                           value))
                     #:version
                     (let ((value (jso-ref node "version")))
                       (if (json-null? value)
                           #f
                           value))
                     #:counts (jso->instance-counts (jso-ref node "counts")))))

(define* (instance-apply-patch value patch)
  "Return VALUE with the RFC 7386 JSON merge patch PATCH applied.
Members of PATCH set to null are removed, and the result is validated
like any other Instance, so a patch that would leave the record invalid raises."
  (jso->instance (json-merge-patch (instance->jso value) patch)))
