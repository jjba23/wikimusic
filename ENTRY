;; -*- mode: Scheme;-*-

;; This an Artanis ENTRY file, don't remove it!

 (use-modules (artanis artanis)
              ;; Put modules you want to be imported here
              ;; only for this file, not controllers/views

              (artanis utils))
 ;; Put whatever you want to be called before server initilization here

 ;; `sf2' is here for the SoundFont a stored Guitar Pro tab is played back
 ;; with: artanis serves a static file only when its extension is named in this
 ;; list, and a SoundFont is served to the page the way a font or an image is.
 ;; `xml' is left out of the static extensions on purpose: the sitemap is built
 ;; from the rows and this instance's own address, so `/sitemap.xml' has to
 ;; reach its route instead of being answered by a file in `pub/'.
 (init-server #:statics '(png gif jpg jpeg ico html js json csv css woff woff2 ttf sf2)
              #:exclude '(xml))
 (add-to-load-path (string-append (current-toplevel) "/lib"))
 (add-to-load-path (string-append (current-toplevel) "/"))

 ;; Pretty pages for the requests that never reach a route (a 404) and for
 ;; the handlers that throw on the way (a 500).  Artanis renders both itself,
 ;; from outside any controller, and this is the point at which it is told
 ;; what to render instead -- before the server takes its first request.
 (use-modules ((app views error) #:prefix error-pages:))
 (error-pages:install-error-pages!)
 ;; Put whatever you want to be called before server running here



 ;; Specify the directory where the MO file is located
 (bindtextdomain "translate" "./sys/i18n/locale")
 (bind-textdomain-codeset "translate" "UTF-8")
 ;; Specify the domain of the MO file since you may have multiple MO files
 (textdomain "translate")
 ;; Set base locale for gettext at startup
 (setlocale LC_MESSAGES "en_US.UTF-8")

(catch #t
  (lambda()
    (display "\nloading env.scm\n")
    (load "env.scm"))
  (lambda(key . args)
    (display (format #f "error loading env.scm: ~a: ~a" key args))))
